<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add skip_contract_configurator to the sale order line form so JS can read it -->
    <record id="view_order_form_contract_simplified" model="ir.ui.view">
        <field name="name">sale.order.form (product_contract_simplified)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="product_contract.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form//field[@name='is_contract']" position="after">
                <field name="skip_contract_configurator" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='is_contract']" position="after">
                <field name="skip_contract_configurator" column_invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
